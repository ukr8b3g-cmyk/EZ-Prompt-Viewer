{
  "name": "ez-prompt-viewer",
  "version": "1.2.0",
  "description": "Windows desktop app for viewing image prompt metadata.",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "test": "node --test",
    "check": "node scripts/check-syntax.cjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "build:check": "electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "local.ez-prompt-viewer",
    "productName": "EZ Prompt Viewer",
    "files": [
      "main.js",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "avif_prompt_viewer.html",
        "to": "avif_prompt_viewer.html"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "about-character.*",
          "icon.*"
        ]
      },
      {
        "from": "designer_adapters.js",
        "to": "designer_adapters.js"
      },
      {
        "from": "workflow_adapter.js",
        "to": "workflow_adapter.js"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "EZ Prompt Viewer Setup.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EZ Prompt Viewer"
    }
  }
}
